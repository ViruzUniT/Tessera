{
  "permissions": {
    "allow": [
      "Bash(premake5 build*)",
      "Bash(premake5 run*)",
      "Bash(premake5 gen*)",
      "Bash(premake5 compdb*)",
      "Bash(premake5 --help)",
      "PowerShell(premake5 build*)",
      "PowerShell(premake5 run*)",
      "PowerShell(premake5 gen*)",
      "PowerShell(premake5 compdb*)",
      "PowerShell(premake5 --help)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(clang-format *)"
    ],
    "deny": [
      "Edit(vendor/**)",
      "Edit(build/**)",
      "Edit(bin/**)",
      "Edit(bin-int/**)",
      "Edit(.tools/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.claude/hooks/layering.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.claude/hooks/format.js\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.claude/hooks/build-check.js\" mark",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.claude/hooks/build-check.js\" check",
            "timeout": 600,
            "statusMessage": "Building to verify edits..."
          }
        ]
      }
    ]
  }
}
